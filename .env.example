# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/labassistant

# --- LLM provider ---
# "openrouter" (hosted) or "local" (any OpenAI-compatible server: Ollama, LM Studio, MLX).
# The app reads whichever set the provider selects — no code change to switch.
LLM_PROVIDER=openrouter

# OpenRouter (hosted). Free models use a ":free" suffix; a bare paid model 402s
# without credits. See https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local (OpenAI-compatible). Point at an Ollama host and set LLM_PROVIDER=local.
# The API key is a placeholder local servers ignore. Prefer context-limited model
# variants (see the note below) so chat and vision can stay loaded together.
LOCAL_API_KEY=local
LOCAL_CHAT_MODEL=gemma4-12b-ctx16k:latest
LOCAL_VISION_MODEL=qwen3-vl-ctx16k:latest
LOCAL_BASE_URL=http://localhost:11434/v1

# Preload the chat + vision models at startup so the first question (and the first
# photo) don't pay a 15-20s cold load. LLM_KEEP_ALIVE sets how long they stay resident
# (Ollama's own default is only 5m, so an idle lab would cold-load repeatedly).
# NOTE: a model's memory use is dominated by its context window -- qwen3-vl:8b at its
# default 256K context needs ~44GB and evicts everything else. Prefer a ctx-limited
# variant (e.g. qwen3-vl-ctx16k) so the chat and vision models can stay loaded together.
WARM_LLM_ON_STARTUP=true
LLM_KEEP_ALIVE=2h

# --- Embeddings (local) ---
# Must match EMBEDDING_DIM in app/config.py (bge-base = 768). Changing the model
# after ingesting requires re-ingesting everything (vectors aren't comparable).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- RAG ---
RETRIEVAL_TOP_K=6
RAG_MAX_CONTEXT_TOKENS=4000
RAG_NOT_FOUND_MESSAGE=I couldn't find that in the available manuals.

# --- Uploads ---
MAX_UPLOAD_MB=100
MAX_BATCH_MB=500
# Long-edge cap for photos sent to the vision model. Phone cameras shoot ~12 MP;
# downscaling cuts upload + prefill time with no loss of on-screen legibility.
VISION_MAX_IMAGE_PX=1536

# Images/docs are kept until an admin deletes them (N3). 0 = never auto-expire.
UPLOAD_RETENTION_DAYS=0

# --- Initial passwords (used by scripts/seed.py; rotate via admin UI after) ---
INITIAL_USER_PASSWORD=changeme-user
INITIAL_ADMIN_PASSWORD=changeme-admin
